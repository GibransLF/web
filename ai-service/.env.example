PORT=8080
HOST=127.0.0.1

# Ollama & Models
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b
OLLAMA_LLM_MODEL=qwen2.5:3b-instruct

# ChromaDB
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_NAME=pmb_knowledge_base

# RAG Parameters
CHUNK_SIZE=600
CHUNK_OVERLAP=100
RETRIEVAL_K=2
LLM_TEMPERATURE=0.2
OLLAMA_TIMEOUT=180
